
  --DDL Script for Silver Layer--
/* This script creates table in the 'silver 'schemas ,dropping _existing  table if they already exists. Runnin this script allows to redeinfe the 
DDL strcutre of the bronze Tables*/


IF OBJECT_ID('silver.crm_cust_info', 'U') IS NOT NULL
    DROP TABLE silver.crm_cust_info;

CREATE TABLE silver.crm_cust_info
(
    cst_id INT,                        -- Customer ID
    cst_key NVARCHAR(50),              -- Customer business key
    cst_firstname NVARCHAR(50),        -- First name
    cst_lastname NVARCHAR(50),         -- Last name
    cst_marital_status NVARCHAR(50),   -- Marital status
    cst_gndr NVARCHAR(50),             -- Gender
    cst_create_date DATE,              -- Record creation date
    dwh_create_date Datetime2 Default getdate()
);





/* -----------------------------------------------------------
   TABLE: silver.crm_prd_info
   Product master data from CRM source system
  -------------------------------------------------------------- */

IF OBJECT_ID('silver.crm_prd_info', 'U') IS NOT NULL
    DROP TABLE silver.crm_prd_info;

CREATE TABLE silver.crm_prd_info
(
    prd_id INT,                    -- Product ID
    cat_id Nvarchar(50),
    prd_key NVARCHAR(50),          -- Product business key
    prd_nm NVARCHAR(50),           -- Product name
    prd_cost INT,                  -- Product cost
    prd_line NVARCHAR(50),         -- Product line
    prd_start_dt DATE,         -- Product start date
    prd_end_dt DATE,            -- Product end date
   dwh_create_date Datetime2 Default getdate() --date for the load of data
);





/* -----------------------------------------------------------
   TABLE: silver.crm_sales_details
   Sales transaction data from CRM source system
  ------------------------------------------------------------- */

IF OBJECT_ID('silver.crm_sales_details', 'U') IS NOT NULL
    DROP TABLE silver.crm_sales_details;

CREATE TABLE silver.crm_sales_details
(
    sls_ord_num NVARCHAR(50),      -- Sales order number
    sls_prd_key NVARCHAR(50),      -- Product key
    sls_cust_id INT,               -- Customer ID
    sls_order_dt DATE,              -- Order date
    sls_ship_dt DATE,               -- Shipping date
    sls_due_dt DATE,                -- Due date
    sls_sales INT,            -- Sales amount
    sls_quantity INT,              -- Quantity sold
    sls_price INT,                  -- Product price
    dwh_create_date Datetime2 Default getdate() -- Data Load Date
);





